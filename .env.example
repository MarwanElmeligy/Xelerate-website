# ── Contact form delivery (choose one) ──────────────────────────────
# Email via Resend (https://resend.com) — verify the sending domain first
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@xelerate.org
CONTACT_FROM_EMAIL=Xelerate Website <website@xelerate.org>
# …or a webhook (CRM, Zapier/Make, NetSuite RESTlet). Receives JSON.
CONTACT_WEBHOOK_URL=

# ── Analytics (set in Vercel *Production* environment only) ─────────
# Values currently live on the WordPress site:
NEXT_PUBLIC_GTM_ID=        # GTM-MCMV52SZ
NEXT_PUBLIC_GA_ID=         # G-YNPKWWC6ZV (leave empty if GA4 fires via GTM)
